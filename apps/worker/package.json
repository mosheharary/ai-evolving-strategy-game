    "@typesafe-ai/sdk": "0.6.0",
    "bullmq": "6.3.11",
    "ioredis": "5.8.2",
    "pg": "8.16.3",
    "pino": "10.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@echoes/ai": "workspace:*",
    "@echoes/database": "workspace:*",
    "@echoes/game-engine": "workspace:*",
    "@echoes/game-types": "workspace:*",
    "@echoes/platform": "workspace:*",
    "@echoes/procedural-world": "workspace:*",
