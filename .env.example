# Echoes of the Frontier — copy to .env and fill in what you have.
# Everything works WITHOUT keys (mock mode). Keys stay server-side only (api + worker).

# --- Google Gemini (narrative + images). GOOGLE_API_KEY is canonical; GEMINI_API_KEY is a fallback.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_TEXT_MODEL=gemini-3.8-flash
GOOGLE_IMAGE_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGE_HERO_MODEL=gemini-3-pro-image
# Explicit Gemini context caching for large, stable lore/rules context (off by default).
GOOGLE_CONTEXT_CACHE=false

# --- TypeSafe (strategic faction decisions via System One)
TYPESAFE_API_KEY=
# jev-latest is an alias; pin e.g. jev-1.13.0 for reproducible deployments.
TYPESAFE_MODEL=jev-latest
# TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- AI mode: auto (live per provider when its key exists, else mock) | live | mock | deterministic
AI_MODE=auto

# --- AI cost control & policy
MAX_AI_REQUESTS_PER_TURN=10
MAX_AI_REQUESTS_PER_GAME=1500
MAX_AI_REQUESTS_PER_USER_PER_DAY=3000
MAX_IMAGES_PER_TURN=2
MAX_IMAGES_PER_GAME=60
AI_EXECUTE_THRESHOLD=0.8
AI_CONSERVATIVE_THRESHOLD=0.55

# --- Infrastructure (docker compose sets these for you; needed only for running outside Docker)
DATABASE_URL=postgresql://echoes:echoes@localhost:5432/echoes
REDIS_URL=redis://localhost:6379
ASSET_STORAGE_DIR=./data/assets
COOKIE_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000
DEV_TOOLS_ENABLED=true
# INTERNAL_TOKEN=
DEMO_MODE=true
LOG_LEVEL=info
